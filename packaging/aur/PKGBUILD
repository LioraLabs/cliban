# Maintainer: Alex Gilbert <code@lioralabs.dev>

pkgname=cliban-bin
pkgver=0.7.1
pkgrel=1
pkgdesc="Self-hosted, agent-first kanban for the terminal: flat CLI, ratatui board, SQLite storage"
arch=('x86_64' 'aarch64')
url="https://github.com/LioraLabs/cliban"
license=('MIT')
provides=('cliban' 'cliband')
conflicts=('cliban' 'cliband')
options=('!strip')

_base="$url/releases/download/v$pkgver"
source_x86_64=("cliban-$pkgver-x86_64.tar.gz::$_base/cliban-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("cliban-$pkgver-aarch64.tar.gz::$_base/cliban-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('6975df33db70f4bd81462a4e9ac89204ce94567e71e12f9d6c43af5ec002cef4')
sha256sums_aarch64=('997e000f816bfd710c7a2589143e45070c28a105dcc7eb8c006d0f0e145b3234')

_srcdir() {
	case "$CARCH" in
		x86_64)  printf 'cliban-v%s-x86_64-unknown-linux-musl' "$pkgver" ;;
		aarch64) printf 'cliban-v%s-aarch64-unknown-linux-musl' "$pkgver" ;;
	esac
}

package() {
	cd "$srcdir/$(_srcdir)"
	install -Dm755 cliban "$pkgdir/usr/bin/cliban"
	install -Dm755 cliband "$pkgdir/usr/bin/cliband"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
