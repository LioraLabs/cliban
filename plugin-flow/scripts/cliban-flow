#!/usr/bin/env bash
# cliban-flow — the git-and-board half of the cliban workflow.
#
# Subcommands map one-to-one onto a board transition or a board-visible verdict.
# The script owns git and the board and nothing else: it never builds, never
# tests, and never interprets a build or test result. That line is deliberate —
# build commands vary per repo and reading their output is judgement, which
# belongs to the agent that called this, not to a shell script.
#
# EXIT CODES are a contract every subcommand keeps, because callers branch on
# them rather than on message text:
#
#   0  the action succeeded, or a read-only verdict is affirmative. Stdout
#      carries the resulting SHA or worktree path for actions, and the verdict
#      for reads.
#   1  the verdict is negative — a real, legitimate state that is not what was
#      asked for. Stdout carries the verdict, except `ticket sync`, where it
#      carries the unmerged paths one per line; stderr names the next command.
#   2  refused. A guard failed or the invocation was malformed, so the question
#      could not be answered at all. Every guard refuses before changing
#      anything; the one exception is a git command that failed partway, and
#      those refusals name in their own text what may have been left behind.
#
# The verdict goes to stdout because it is the answer; refusals, warnings and
# instructions go to stderr.
#
# BOARD LINES. Every invocation that resolves a ticket appends one line to that
# ticket's activity log under the stable prefix "[cliban-flow]", in the shape
#
#   [cliban-flow] <group> <command> <KEY>: <outcome> (<detail>)
#
# so a compacted orchestrator, a recovery survey, or a test assertion can
# reconstruct what ran. An invocation that never resolves a ticket — a usage
# error, an unknown key — has no log to append to and prints only.
#
# A subcommand acting on a milestone rather than a ticket writes its line to
# that milestone's activity log via `cliban milestone log`, which is why those
# subcommands take a project scope: milestone names are unique per project, not
# globally. The line itself is still built by board_line(), so a recovery survey
# parses one format across both logs.

set -euo pipefail

PROG=cliban-flow
BOARD_PREFIX='[cliban-flow]'

# "<group> <command>", set by the dispatcher and used in every board line.
ACTION=""
# The repository every git call runs against; set by require_repo.
REPO=""
# The loaded ticket; set by load_issue.
ISSUE_KEY="" ISSUE_BRANCH="" ISSUE_MILESTONE="" ISSUE_PROJECT="" ISSUE_STATUS="" ISSUE_TITLE="" ISSUE_CLAIMED_BY=""
# The loaded milestone; set by load_milestone.
MILESTONE_NAME="" MILESTONE_BRANCH=""
# The project key milestone reads and writes are scoped by; set by
# require_project from --project or $CLIBAN_PROJECT.
PROJECT=""
# --project, when a subcommand parsed one.
FLOW_PROJECT=""

# ---------------------------------------------------------------- output

say() { printf '%s\n' "$*"; }
warn() { printf '%s: %s\n' "$PROG" "$*" >&2; }

# announce <what> — what a creating or destructive step is about to do, printed
# before it runs, so an interrupted run leaves a record of how far it got. On
# stderr with everything else that is not the answer: a caller does
# `wt=$(cliban-flow ticket start KEY)` and gets the path alone only while the
# narration stays off stdout.
announce() { printf '%s: %s\n' "$PROG" "$*" >&2; }

# instruct <line>... — the "what to do next" that follows a verdict or refusal.
# Indented on stderr so it reads as guidance rather than as more output.
instruct() {
    local line
    for line in "$@"; do printf '  %s\n' "$line" >&2; done
}

# refuse <summary> <instruction>... — a guard failed. Nothing was changed.
refuse() {
    local summary=$1
    shift
    printf '%s: refused: %s\n' "$PROG" "$summary" >&2
    instruct "$@"
    exit 2
}

# refuse_ticket <KEY> <summary> <instruction>... — a guard failed on a ticket
# that did resolve, so the refusal is recorded before exiting. Refusals reached
# before a key is known (a bad key, the wrong directory) have nowhere to write
# and print only.
refuse_ticket() {
    local key=$1 summary=$2
    shift 2
    board_record "$key" "refused ($summary)"
    refuse "$summary" "$@"
}

# refuse_milestone <NAME> <summary> <instruction>... — refuse_ticket one level
# up: a guard failed on a milestone that did resolve, so the refusal lands on
# the milestone's own activity log before exiting.
refuse_milestone() {
    local name=$1 summary=$2
    shift 2
    board_record_milestone "$name" "refused ($summary)"
    refuse "$summary" "$@"
}

usage_error() {
    printf '%s: %s\n' "$PROG" "$1" >&2
    usage >&2
    exit 2
}

usage() {
    cat <<EOF
usage: cliban-flow <group> <command> [args]

  milestone start <NAME> [-p KEY]
                        Create milestone/<slug> off main and check it out in
                        its own worktree, a sibling of the primary checkout.
                        Prints the worktree path.

  milestone finish <NAME> [-p KEY]
                        Fast-forward main to the milestone branch. Prints the
                        landed SHA.

  milestone status <NAME> [-p KEY]
                        Read-only recovery survey of the board, milestone,
                        ticket branches and their registered worktrees.

  milestone abandon <NAME> [-p KEY] --confirm <REASON>
                        Release its tickets and discard clean milestone work.

  ticket start <KEY>    Create <KEY>'s branch off the current milestone tip and
                        check it out in a worktree under the milestone
                        worktree. Prints the worktree path.

  ticket status <KEY>   Is <KEY>'s branch integrable? Read-only: prints
                        "mergeable" (exit 0) when the milestone branch tip is
                        an ancestor of the ticket branch, "sync-required"
                        (exit 1) when it is not.

  ticket sync <KEY>     Merge the milestone tip into the ticket branch. Prints
                        the resulting tip SHA, or conflicted paths at exit 1.

  ticket ready <KEY>    Verify the synced branch and clean worktree, then move
                        the ticket to in-review. Prints the ticket tip SHA.

  ticket integrate <KEY> [--dry-run]
                        Squash a ready ticket onto its milestone branch, mark it
                        done, and remove its worktree. Dry-run only reports.

  ticket abandon <KEY> --confirm <REASON>
                        Release the claim and discard clean ticket work.

Both start subcommands are idempotent: a second run reports what is already
there rather than recreating it.

Exit codes: 0 affirmative or done, 1 a negative verdict with the fix printed,
2 refused — a guard failed; the refusal names what to do next.
EOF
}

# ---------------------------------------------------------------- board
#
# The activity log is this system's audit trail: recovery reads it to work out
# where an interrupted milestone stands, and a behavioural scenario greps it to
# prove an orchestrator reached for the tool. It is not the authority on whether
# anything happened, so writing it is best-effort — an unreachable board must
# never turn a clean verdict into a failure, only into a warning.

# board_line <subject> <outcome>... — the documented shape, and the only place
# it is built. Anything that has to parse these lines parses this format.
#
# The subject is an issue key for a ticket line and a milestone name for a
# milestone line, and a milestone name is free text that may itself contain
# ": ". A parser therefore identifies a line by its fixed prefix — the literal
# marker plus the group and command it already knows — and treats everything
# after it as subject-and-outcome for the object whose log it is reading, rather
# than splitting on the first or last colon.
board_line() { printf '%s %s %s: %s' "$BOARD_PREFIX" "$ACTION" "$1" "${*:2}"; }

# board_record <KEY> <outcome>... — append one line to a ticket's activity log.
board_record() {
    cliban issue log "$1" "$(board_line "$@")" >/dev/null 2>&1 ||
        warn "could not record on $1's activity log; the board is out of date"
}

# board_record_milestone <NAME> <outcome>... — the same line, on a milestone's
# activity log. A subcommand acting on a milestone has no ticket to append to,
# and `cliban milestone log` is that destination; the line itself is still
# built by board_line, so one parser reads both logs.
#
# Scoped by $PROJECT because milestone names are unique per project, not
# globally — `milestone log` refuses without a scope.
board_record_milestone() {
    cliban milestone log "$1" -p "$PROJECT" "$(board_line "$@")" >/dev/null 2>&1 ||
        warn "could not record on milestone \"$1\"'s activity log; the board is out of date"
}

# ---------------------------------------------------------------- git
#
# Everything runs as `git -C "$REPO"` rather than relying on the caller's cwd,
# so a subcommand cannot be talked into acting on whatever directory a shell
# happened to be left in.

require_repo() {
    REPO=$(git rev-parse --show-toplevel 2>/dev/null) || refuse \
        "not inside a git repository" \
        "cd into the repository, or into the ticket worktree, and try again."
}

gitr() { git -C "$REPO" "$@"; }

# have_branch <name> — a local branch, specifically. Resolving the bare name
# would also match a tag or a remote-tracking ref, and this protocol only ever
# merges local branches.
have_branch() { gitr rev-parse --verify --quiet "refs/heads/$1" >/dev/null; }

short_sha() { gitr rev-parse --short "refs/heads/$1"; }

# full_sha <branch> — the same commit, unabbreviated. Short shas are for reading
# and appear in every message and board line; the full one is what goes on
# stdout, where the reader is a script and an abbreviation is a hostage to how
# many objects the repository grows.
full_sha() { gitr rev-parse "refs/heads/$1"; }

# is_ancestor <branch-a> <branch-b> — true when every commit of <a> is reachable
# from <b>. Strict ancestry is the whole gate: never a trial merge, because a
# trial merge answers "would this apply cleanly", and the question that matters
# is "was the tree that was tested the tree that will land".
#
# Both sides are resolved as refs/heads, like every other lookup here. Bare
# names would be disambiguated tags-before-branches, so a stray tag sharing a
# branch's name would answer this with a different commit than the one the
# guard checked and the one the message reports — a false `mergeable`, which is
# the single failure this gate exists to prevent.
is_ancestor() { gitr merge-base --is-ancestor "refs/heads/$1" "refs/heads/$2"; }

# ---------------------------------------------------------------- worktrees
#
# Two rules hold this layout up, and both come from an incident rather than a
# preference. The milestone branch never enters the primary checkout — checking
# it out there once live-patched a running service that execs out of the working
# tree. Ticket worktrees hang off the milestone worktree, so the milestone's
# build state never lands in the tree the user runs from.
#
# `git worktree list --porcelain` is the only machine-readable view git offers
# of that layout, and the awk below never exits early: under `pipefail` an early
# exit can leave git killed by SIGPIPE, which would turn a successful lookup
# into a failed one.

# primary_worktree — the repository's main worktree. git documents it as the
# first record of `worktree list`, and it is the one checkout this script may
# never create a branch in or hang a worktree off.
primary_worktree() {
    gitr worktree list --porcelain |
        awk '/^worktree /{ if (!seen) { seen = 1; print substr($0, 10) } }'
}

# worktree_for_branch <branch> — the absolute path of the worktree that has
# <branch> checked out, or empty when no worktree does. Matched against the full
# `refs/heads/` ref that porcelain prints, for the same reason have_branch
# resolves one: a bare name would also match a tag.
worktree_for_branch() {
    gitr worktree list --porcelain | awk -v want="branch refs/heads/$1" '
        /^worktree /{ path = substr($0, 10) }
        $0 == want { found = path }
        END { if (found != "") print found }'
}

# worktree_missing <path> — registered with git but no longer on disk. git keeps
# listing such a worktree, and keeps refusing to check its branch out anywhere
# else, until someone prunes it; taking a registration at face value is how a
# subcommand comes to report a path its caller cannot cd into.
worktree_missing() { [ ! -d "$1" ]; }

# worktree_head <path> — what is checked out in the worktree at <path>: a branch
# name, the word `detached`, or empty when <path> is not a worktree of this
# repository at all. The difference matters in the refusals: a live worktree
# sitting on the wrong ref is repaired by checking the right one out, and
# advising someone to move it aside instead would break git's registration.
worktree_head() {
    gitr worktree list --porcelain | awk -v want="worktree $1" '
        $0 == want { here = 1; next }
        here == 1 && /^branch refs\/heads\//{
            sub(/^branch refs\/heads\//, ""); print; here = 0
        }
        here == 1 && $0 == "detached" { print "detached"; here = 0 }
        $0 == "" { here = 0 }'
}

# worktree_head_desc <worktree_head answer> — the same, in a sentence.
worktree_head_desc() {
    case $1 in
        detached) printf 'with a detached HEAD' ;;
        *) printf 'on branch %s' "$1" ;;
    esac
}

# prune_instructions — the guidance both start subcommands give for a
# registration whose directory is gone. Written once because the two refusals
# differ only in which log they land on, and drifting apart would leave one of
# them telling the operator to do something subtly different.
prune_instructions() {
    printf '%s\n' \
        "git still holds that worktree, so it will not check the branch out" \
        "anywhere else until the registration is cleared. Confirm nothing there" \
        "is wanted, then:" \
        "" \
        "    git -C \"$REPO\" worktree prune"
}

# read_prune_instructions — the lines above, into PRUNE_INSTRUCTIONS, which a
# refusal can splat. A read loop rather than `mapfile`, which would be the only
# bash-4 construct in the file.
PRUNE_INSTRUCTIONS=()
read_prune_instructions() {
    local line
    PRUNE_INSTRUCTIONS=()
    while IFS= read -r line; do PRUNE_INSTRUCTIONS+=("$line"); done < <(prune_instructions)
}

# worktree_dirty <path> — anything uncommitted, tracked or not, except the
# ticket worktrees this script itself puts under `.worktrees/`.
#
# The exclusion is not a convenience. A repo that does not gitignore
# `.worktrees/` — and nothing requires one to — would show the first ticket
# worktree as untracked, and every later `ticket start` in the same milestone
# would then refuse the milestone worktree as dirty because of a directory this
# tool created. The guard is about the operator's work in flight, so this tool's
# own artifacts are not evidence of it.
worktree_dirty() {
    [ -n "$(git -C "$1" status --porcelain -- ':(exclude).worktrees' 2>/dev/null)" ]
}

# merge_in_progress <path> — a merge left half-finished in the worktree at
# <path>. Read as a ref rather than by looking for a file: MERGE_HEAD is
# per-worktree state, so it lives in the linked worktree's own git directory and
# a hard-coded `.git/MERGE_HEAD` would answer about the primary checkout
# instead. This is the state a conflicting `ticket sync` deliberately leaves
# behind, so recognising it is how the second run says something useful.
merge_in_progress() { git -C "$1" rev-parse --verify --quiet MERGE_HEAD >/dev/null 2>&1; }

# path_within <root> <path> — is <path> inside <root>? Compared after purely
# lexical normalisation, so neither path has to exist yet and no amount of `..`
# in a name can spell its way past the check. python3 rather than `realpath -m`:
# this script already requires the one and not the other.
path_within() {
    local root path
    root=$(python3 -c 'import os, sys; print(os.path.normpath(sys.argv[1]))' "$1") || return 1
    path=$(python3 -c 'import os, sys; print(os.path.normpath(sys.argv[1]))' "$2") || return 1
    case $path in
        "$root"/?*) return 0 ;;
        *) return 1 ;;
    esac
}

# ---------------------------------------------------------------- the board's issues

# json_fields <field>... — the named fields of the JSON object on stdin,
# separated by US (0x1f), empty for absent. One python3 call per subcommand
# rather than one per field, so there is a single place for a parse to fail
# loudly. Adding a field is one name here and one variable in the `read` that
# consumes it.
#
# Not tab separated, which is what this was until a field that can legitimately
# be empty stopped being the last one. Tab is IFS *whitespace*, so `read`
# collapses a run of tabs into one delimiter: an absent field in the middle
# vanishes and every field after it shifts up one, silently, with no failure
# anywhere. 0x1f is not whitespace and cannot occur in cliban's output, so an
# empty field stays an empty field. Every consumer must therefore split on
# $'\x1f' and nothing else.
json_fields() {
    python3 -c 'import json, sys
d = json.load(sys.stdin)
print("\x1f".join("" if d.get(f) is None else str(d[f]) for f in sys.argv[1:]))' "$@"
}

# json_lines_field <field> — one field per line, for cliban's JSONL listings.
# Separate from json_fields because that one reads a single object; this reads a
# stream of them and the two failure modes should not be confused.
json_lines_field() {
    python3 -c 'import json, sys
for line in sys.stdin:
    line = line.strip()
    if line:
        v = json.loads(line).get(sys.argv[1])
        print("" if v is None else str(v))' "$1"
}

require_python() {
    command -v python3 >/dev/null || refuse \
        "python3 is not on PATH" \
        "cliban-flow reads cliban's JSON with python3."
}

# load_issue <KEY> — populate the ISSUE_* globals, or refuse. Every read here
# either succeeds or refuses: a half-loaded issue would let a later guard answer
# the wrong question about the wrong branch.
load_issue() {
    require_python
    local json row
    json=$(cliban issue show "$1" --json 2>/dev/null) || refuse \
        "no issue named $1 on the board" \
        "Check the key. If this is a scratch board, check CLIBAN_DB points at it."
    row=$(printf '%s' "$json" | json_fields key git_branch_name milestone status title claimed_by) || refuse \
        "could not read $1 from the board" \
        "\`cliban issue show $1 --json\` returned something this script could not" \
        "parse. cliban may be newer or older than this dispatcher expects."
    IFS=$'\x1f' read -r ISSUE_KEY ISSUE_BRANCH ISSUE_MILESTONE ISSUE_STATUS ISSUE_TITLE ISSUE_CLAIMED_BY <<<"$row"
    # The board's own spelling of the key, so the audit trail stays greppable
    # when someone types `flow-1`.
    [ -n "$ISSUE_KEY" ] && [ -n "$ISSUE_BRANCH" ] || refuse \
        "the board gave no key or branch name for $1" \
        "This dispatcher needs \`key\` and \`git_branch_name\` on \`issue show --json\`."
    # `issue show --json` carries no project, but the key is `<PROJECT>-<n>` and
    # project keys hold no dash. A ticket subcommand needs this whenever it has
    # to name a milestone-scoped command in its own guidance.
    ISSUE_PROJECT=${ISSUE_KEY%%-*}
}

# slugify <text> — cliban's own branch-name rules, reimplemented: lowercase,
# every run of non-alphanumerics collapsed to one dash, trimmed, capped at 60.
# cliban publishes `git_branch_name` for an issue but nothing equivalent for a
# milestone, so the milestone branch name is derived here and has to stay in
# step with git_branch_name() in crates/cliban/src/output.rs. LC_ALL is pinned
# because the character classes below are ASCII by intent, not by accident.
slugify() {
    LC_ALL=C printf '%s' "$1" |
        LC_ALL=C tr '[:upper:]' '[:lower:]' |
        LC_ALL=C sed -e 's/[^a-z0-9][^a-z0-9]*/-/g' -e 's/^-//' -e 's/-$//' |
        LC_ALL=C cut -c 1-60 |
        LC_ALL=C sed -e 's/-$//'
}

milestone_branch() { printf 'milestone/%s' "$(slugify "$1")"; }

# ---------------------------------------------------------------- the board's milestones

# require_project — the scope every milestone read and write needs, from
# --project or the environment. Refusing rather than guessing: a milestone name
# resolves per project, so the wrong scope would silently act on a different
# milestone that happens to share a name.
require_project() {
    PROJECT=${FLOW_PROJECT:-${CLIBAN_PROJECT:-}}
    [ -n "$PROJECT" ] || refuse \
        "no project scope for the milestone" \
        "Milestone names are unique per project, not globally. Name the project:" \
        "" \
        "    $PROG $ACTION ... -p <KEY>" \
        "" \
        "or export CLIBAN_PROJECT."
}

# load_milestone <NAME> — populate MILESTONE_*, or refuse. The milestone has to
# exist on the board before a branch is named after it: a typo would otherwise
# create a real branch and a real worktree for a milestone nobody is tracking,
# and the board line recording it would go nowhere.
load_milestone() {
    require_python
    local json name
    json=$(cliban milestone show "$1" -p "$PROJECT" --json 2>/dev/null) || refuse \
        "no milestone named \"$1\" on project $PROJECT" \
        "Check the name and the project. Milestones are listed by:" \
        "" \
        "    cliban milestone ls -p $PROJECT" \
        "" \
        "Refusing rather than creating it: a branch named after a milestone that" \
        "does not exist has nothing to integrate into."
    name=$(printf '%s' "$json" | json_fields name) || refuse \
        "could not read milestone \"$1\" from the board" \
        "\`cliban milestone show\` returned something this script could not parse."
    # The board's own spelling, so the audit trail stays greppable.
    [ -n "$name" ] || refuse \
        "the board gave no name for milestone \"$1\"" \
        "This dispatcher needs \`name\` on \`milestone show --json\`."
    MILESTONE_NAME=$name
    MILESTONE_BRANCH=$(milestone_branch "$name")
    # The milestone resolved, so from here every refusal lands on its log.
    [ "$MILESTONE_BRANCH" != "milestone/" ] || refuse_milestone "$name" \
        "milestone \"$name\" has no usable branch name" \
        "Its name slugifies to nothing, so there is no branch it could refer to." \
        "Rename the milestone to something containing letters or digits."

    # Slugifying is lossy, so two milestones in one project can name the same
    # branch — "Test milestone" and "Test-Milestone!" both do, and cliban
    # accepts both. One branch and one worktree cannot serve two milestones:
    # whichever started second would be handed the first one's tree and told it
    # was already started. Caught here, before anything is created.
    local names other
    # Captured rather than piped straight into the loop: a listing that failed
    # would otherwise produce no lines, run the loop body zero times, and report
    # no collision — a guard that answers "all clear" when it could not look.
    names=$(cliban milestone ls -p "$PROJECT" --json 2>/dev/null | json_lines_field name) ||
        refuse_milestone "$name" \
            "could not list the milestones on project $PROJECT" \
            "Two milestones can derive one branch name, so this has to be checked" \
            "before a branch is created. It needs \`cliban milestone ls -p $PROJECT" \
            "--json\` to be readable."
    while IFS= read -r other; do
        [ -n "$other" ] && [ "$other" != "$name" ] || continue
        [ "$(milestone_branch "$other")" != "$MILESTONE_BRANCH" ] || refuse_milestone "$name" \
            "milestones \"$name\" and \"$other\" both name the branch $MILESTONE_BRANCH" \
            "Branch names are derived from milestone names, and these two derive" \
            "the same one, so a single branch and worktree would have to serve" \
            "both. Rename one of them so the two differ by more than punctuation" \
            "or case."
    done <<<"$names"
}

unsettled_milestone_issues() {
    local rows candidates key title activity unsettled=""
    rows=$(cliban issue ls -p "$PROJECT" -m "$MILESTONE_NAME" --full --archived --json 2>/dev/null) || return 1
    candidates=$(printf '%s' "$rows" | python3 -c 'import json, sys
for line in sys.stdin:
    issue = json.loads(line)
    if issue["status"] != "done" and not issue["archived"]:
        print(f"{issue['"'"'key'"'"']}\x1f{issue['"'"'title'"'"']}")') || return 1
    while IFS=$'\x1f' read -r key title; do
        [ -n "$key" ] || continue
        activity=$(cliban issue cat "$key" --section activity 2>/dev/null) || activity=""
        printf '%s' "$activity" | grep -qF 'work discarded:' && continue
        unsettled="${unsettled:+$unsettled, }$key: $title"
    done <<<"$candidates"
    printf '%s' "$unsettled"
}

# parse_project_option — strips --project/-p out of a subcommand's arguments and
# leaves the rest in ARGS_REST. Only milestone-scoped subcommands call it.
ARGS_REST=()
parse_project_option() {
    ARGS_REST=()
    while [ $# -gt 0 ]; do
        case $1 in
            -p | --project)
                [ $# -ge 2 ] || usage_error "$1 needs a project key"
                FLOW_PROJECT=$2
                shift 2
                ;;
            --project=*)
                FLOW_PROJECT=${1#--project=}
                shift
                ;;
            --)
                shift
                while [ $# -gt 0 ]; do
                    ARGS_REST+=("$1")
                    shift
                done
                ;;
            -*) usage_error "unknown option: $1" ;;
            *)
                ARGS_REST+=("$1")
                shift
                ;;
        esac
    done
}

# ------------------------------------------------------- the ticket guard layer
#
# Four ticket subcommands ask the same questions of the same board and the same
# repository, and the answer must not depend on which one is asking. Every
# question with a single right answer lives here once; a subcommand supplies
# only the part that is genuinely its own — the reason it needs a milestone at
# all.
#
# This is not tidiness. `milestone start` and `ticket start` were written as two
# guard chains over one helper layer, and every defect their review found was a
# place the two disagreed: one refused the primary checkout, its twin reported
# that same checkout as the answer to a caller whose next step was to build
# there. None of it was visible from inside either subcommand, because a test
# for one command cannot see what the other does with the same state.

# The milestone branch this ticket integrates into; set by
# load_ticket_milestone_branch.
TICKET_MBRANCH=""
# The worktree the ticket branch is checked out in; set by load_ticket_worktree.
TICKET_WT=""

# require_ticket_branch — the ticket has a branch in this repository at all.
# Every subcommand past `start` needs one and none of them may invent it: a
# branch created at this point would be an empty answer to "what has been
# implemented".
require_ticket_branch() {
    have_branch "$ISSUE_BRANCH" || refuse_ticket "$ISSUE_KEY" \
        "the ticket branch $ISSUE_BRANCH does not exist here" \
        "Nothing has been implemented on $ISSUE_KEY yet, or this repository is" \
        "not where it was. Start it with:" \
        "" \
        "    $PROG ticket start $ISSUE_KEY"
}

# load_ticket_milestone_branch <clause> <instruction>... — the milestone branch
# this ticket integrates into, into TICKET_MBRANCH, or refuse.
#
# <clause> completes "$KEY is on no milestone, so <clause>", and the
# instructions after it are the caller's own account of why it needs one: a
# branch to start from, a tip to be checked against, something to merge in.
# Below that first guard nothing varies by caller — what an empty slug means,
# and why a missing milestone branch is never created here, are the same facts
# whichever subcommand ran into them.
load_ticket_milestone_branch() {
    local clause=$1
    shift
    [ -n "$ISSUE_MILESTONE" ] || refuse_ticket "$ISSUE_KEY" \
        "$ISSUE_KEY is on no milestone, so $clause" \
        "$@" \
        "" \
        "    cliban issue edit $ISSUE_KEY --milestone \"<name>\""

    TICKET_MBRANCH=$(milestone_branch "$ISSUE_MILESTONE")
    [ "$TICKET_MBRANCH" != "milestone/" ] || refuse_ticket "$ISSUE_KEY" \
        "milestone \"$ISSUE_MILESTONE\" has no usable branch name" \
        "Its name slugifies to nothing, so there is no branch it could refer to." \
        "Rename the milestone to something containing letters or digits."

    have_branch "$TICKET_MBRANCH" || refuse_ticket "$ISSUE_KEY" \
        "the milestone branch $TICKET_MBRANCH does not exist here" \
        "$ISSUE_KEY is on milestone \"$ISSUE_MILESTONE\", whose branch would be" \
        "$TICKET_MBRANCH. Create it, in its own worktree:" \
        "" \
        "    $PROG milestone start \"$ISSUE_MILESTONE\" -p $ISSUE_PROJECT" \
        "" \
        "Refusing rather than creating it here: a milestone branch invented at" \
        "this point decides what the ticket integrates into, and answers any" \
        "question asked about it by defining it away."
}

# load_ticket_worktree — the worktree the ticket branch is checked out in, into
# TICKET_WT, or refuse. Anything that changes a working tree, or reads one for
# work in flight, needs this; `ticket status`, which only reads refs, does not
# and must keep working in a repository with no worktrees at all.
#
# The guards are shared deliberately, in one order, so that `sync` and `ready`
# cannot come to disagree about which of these states is acceptable. Each one
# refuses before anything is changed.
load_ticket_worktree() {
    local primary
    primary=$(primary_worktree) || refuse \
        "could not read this repository's worktree list" "git's own error is above."
    TICKET_WT=$(worktree_for_branch "$ISSUE_BRANCH") || refuse \
        "could not read this repository's worktree list" "git's own error is above."

    [ -n "$TICKET_WT" ] || refuse_ticket "$ISSUE_KEY" \
        "$ISSUE_BRANCH exists but is checked out in no worktree" \
        "This acts on the ticket's own worktree rather than on whatever tree the" \
        "caller happens to be standing in, and $ISSUE_KEY has none. Make it:" \
        "" \
        "    $PROG ticket start $ISSUE_KEY"

    # The same hazard `ticket start` refuses to create, met from the other end:
    # someone checked the ticket branch out in the primary checkout to look at
    # it, and this would now merge into, or vouch for, the tree the user works
    # and runs from.
    [ "$TICKET_WT" != "$primary" ] || refuse_ticket "$ISSUE_KEY" \
        "$ISSUE_BRANCH is checked out in the primary checkout $primary" \
        "That is the tree the user works and runs from, and a ticket's work never" \
        "belongs in it. Free the branch and give it its own worktree:" \
        "" \
        "    git -C \"$primary\" checkout main" \
        "    $PROG ticket start $ISSUE_KEY"

    read_prune_instructions
    ! worktree_missing "$TICKET_WT" || refuse_ticket "$ISSUE_KEY" \
        "$ISSUE_BRANCH is registered to $TICKET_WT, which no longer exists" \
        "${PRUNE_INSTRUCTIONS[@]}" \
        "    $PROG ticket start $ISSUE_KEY"

    # Half a merge is not a state to act on top of, and not one to discard
    # either: whatever is resolved in that index was resolved by someone.
    ! merge_in_progress "$TICKET_WT" || refuse_ticket "$ISSUE_KEY" \
        "a merge is already in progress in $TICKET_WT" \
        "Finish it or abandon it before anything else acts on this branch:" \
        "" \
        "    git -C \"$TICKET_WT\" status" \
        "    git -C \"$TICKET_WT\" commit        # keep the resolution" \
        "    git -C \"$TICKET_WT\" merge --abort # throw it away"

    ! worktree_dirty "$TICKET_WT" || refuse_ticket "$ISSUE_KEY" \
        "the ticket worktree $TICKET_WT has uncommitted changes" \
        "What integration reads is the branch, and uncommitted work is not on it," \
        "so anything decided here would be decided about a different tree. Commit" \
        "or stash it first:" \
        "" \
        "    git -C \"$TICKET_WT\" status"
}

# ---------------------------------------------------------------- dispatch
#
# One group per noun, one case arm per command. A new subcommand is one arm and
# one cmd_* function; nothing else moves.

milestone_dispatch() {
    local command=${1:-}
    if [ $# -gt 0 ]; then shift; fi
    case $command in
        start)
            ACTION="milestone start"
            cmd_milestone_start "$@"
            ;;
        finish)
            ACTION="milestone finish"
            cmd_milestone_finish "$@"
            ;;
        status)
            ACTION="milestone status"
            cmd_milestone_status "$@"
            ;;
        abandon)
            ACTION="milestone abandon"
            cmd_milestone_abandon "$@"
            ;;
        '') usage_error "milestone needs a command" ;;
        *) usage_error "unknown milestone command: $command" ;;
    esac
}

ticket_dispatch() {
    local command=${1:-}
    if [ $# -gt 0 ]; then shift; fi
    case $command in
        start)
            ACTION="ticket start"
            cmd_ticket_start "$@"
            ;;
        status)
            ACTION="ticket status"
            cmd_ticket_status "$@"
            ;;
        sync)
            ACTION="ticket sync"
            cmd_ticket_sync "$@"
            ;;
        ready)
            ACTION="ticket ready"
            cmd_ticket_ready "$@"
            ;;
        integrate)
            ACTION="ticket integrate"
            cmd_ticket_integrate "$@"
            ;;
        abandon)
            ACTION="ticket abandon"
            cmd_ticket_abandon "$@"
            ;;
        '') usage_error "ticket needs a command" ;;
        *) usage_error "unknown ticket command: $command" ;;
    esac
}

main() {
    [ $# -gt 0 ] || { usage >&2; exit 2; }
    local group=$1
    shift
    case $group in
        help | -h | --help) usage ;;
        milestone) milestone_dispatch "$@" ;;
        ticket) ticket_dispatch "$@" ;;
        *) usage_error "unknown command group: $group" ;;
    esac
}

# ---------------------------------------------------------------- commands

# milestone status <NAME> [-p KEY] — reconstruct every durable fact needed to
# resume an interrupted milestone. Unlike action subcommands, a survey records
# no board line: observation must not become the newest action it is reporting.
cmd_milestone_status() {
    parse_project_option "$@"
    set -- ${ARGS_REST[@]+"${ARGS_REST[@]}"}
    local name=${1:-}
    [ -n "$name" ] || usage_error "milestone status needs a milestone name"
    [ $# -le 1 ] || usage_error "milestone status takes one milestone name, got: $*"
    require_repo
    require_project
    load_milestone "$name"

    REPO="$REPO" PROJECT="$PROJECT" MILESTONE_NAME="$MILESTONE_NAME" \
        MILESTONE_BRANCH="$MILESTONE_BRANCH" python3 - <<'PY'
import json
import os
import re
import subprocess

repo = os.environ["REPO"]
project = os.environ["PROJECT"]
name = os.environ["MILESTONE_NAME"]
mbranch = os.environ["MILESTONE_BRANCH"]

def run(*args, check=True):
    p = subprocess.run(args, cwd=repo, text=True, stdout=subprocess.PIPE,
                       stderr=subprocess.DEVNULL)
    if check and p.returncode:
        raise SystemExit(f"cliban-flow: survey could not run: {' '.join(args)}")
    return p

def git(*args, check=True):
    return run("git", *args, check=check)

def cliban(*args):
    return run("cliban", *args).stdout

def branch_exists(branch):
    return git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}",
               check=False).returncode == 0

def ancestor(left, right):
    return git("merge-base", "--is-ancestor", f"refs/heads/{left}",
               f"refs/heads/{right}", check=False).returncode == 0

worktrees = {}
path = None
for line in git("worktree", "list", "--porcelain").stdout.splitlines():
    if line.startswith("worktree "):
        path = line[9:]
    elif line.startswith("branch refs/heads/") and path:
        worktrees[line[18:]] = path
    elif not line:
        path = None

issues = [json.loads(line) for line in cliban(
    "issue", "ls", "-p", project, "-m", name, "--all", "--full", "--json"
).splitlines() if line]
waves = json.loads(cliban("milestone", "waves", name, "-p", project, "--json"))

have_milestone = branch_exists(mbranch)
if have_milestone and branch_exists("main"):
    main_drift = "no" if ancestor("main", mbranch) else "yes"
else:
    main_drift = "unknown"

parts = ["[" + ", ".join(wave) + "]" for wave in waves.get("waves", [])]
print(f"milestone: {name}")
print(f"project: {project}")
print(f"branch: {mbranch if have_milestone else 'missing'}")
print(f"main-drift: {main_drift}")
print("waves: " + (" -> ".join(parts) if parts else "none"))
if waves.get("done"):
    print("done: " + ", ".join(waves["done"]))
if waves.get("external_blocked"):
    print("external-blocked: " + ", ".join(waves["external_blocked"]))

for issue in issues:
    key = issue["key"]
    branch = issue["git_branch_name"]
    claim = issue.get("claimed_by") or "none"
    description = issue.get("description") or ""
    actions = [line[line.index("[cliban-flow]"):].strip()
               for line in description.splitlines() if "[cliban-flow]" in line]
    last = actions[-1] if actions else "none"
    have_ticket = branch_exists(branch)
    integrated = "no"
    if have_milestone:
        found = git("log", f"refs/heads/{mbranch}", "--extended-regexp",
                    f"--grep=^Ticket: {re.escape(key)}$", "-1",
                    "--format=%H").stdout.strip()
        integrated = "yes" if found else "no"
    ahead = 0
    relation = "missing"
    if have_milestone and have_ticket:
        ahead = int(git("rev-list", "--count",
                        f"refs/heads/{mbranch}..refs/heads/{branch}").stdout)
        if ancestor(mbranch, branch):
            relation = "level" if ancestor(branch, mbranch) else "descendant"
        elif ancestor(branch, mbranch):
            relation = "ancestor"
        else:
            relation = "diverged"
    ticked = bool(re.search(r"^- \[[xX]\]", description, re.MULTILINE))
    silent = issue.get("status") == "in-progress" and ahead > 0 and not ticked

    print(f"ticket: {key} status={issue['status']} claim={claim}")
    print(f"  branch: {branch if have_ticket else 'missing'}")
    print(f"  integrated: {integrated}")
    print(f"  last-action: {last}")
    print(f"  silent-agent: {'yes' if silent else 'no'}")
    wt = worktrees.get(branch)
    if not wt:
        print("  worktree: none")
        print(f"  ahead: {ahead}")
        print(f"  relation: {relation}")
        continue
    if not os.path.isdir(wt):
        print(f"  worktree: {wt} (missing)")
        print(f"  ahead: {ahead}")
        print(f"  relation: {relation}")
        continue
    print(f"  worktree: {wt}")
    status = git("-C", wt, "status", "--porcelain", "--", ":(exclude).worktrees",
                 check=False).stdout.strip().splitlines()
    unmerged = git("-C", wt, "diff", "--name-only", "--diff-filter=U",
                   check=False).stdout.strip().splitlines()
    merging = git("-C", wt, "rev-parse", "--verify", "--quiet", "MERGE_HEAD",
                  check=False).returncode == 0
    print(f"  dirty: {'yes' if status else 'no'}")
    print("  uncommitted: " + (", ".join(status) if status else "none"))
    print(f"  merge: {'yes' if merging else 'no'}")
    print("  unmerged: " + (", ".join(unmerged) if unmerged else "none"))
    print(f"  ahead: {ahead}")
    print(f"  relation: {relation}")
PY
}

# milestone start <NAME> [-p KEY] — stand up the milestone's git layout.
#
# The worktree goes beside the primary checkout, at the primary checkout's own
# path with the milestone slug appended, so `.../cliban` plus milestone
# "Deterministic integration" gives `.../cliban-deterministic-integration`. A
# sibling rather than a child: a worktree inside the primary checkout would put
# the milestone's whole build state into the tree the user works and runs from,
# which is the thing this layout exists to prevent.
#
# Stdout is the worktree path and nothing else, because the caller's next step
# is to cd into it.
cmd_milestone_start() {
    parse_project_option "$@"
    set -- ${ARGS_REST[@]+"${ARGS_REST[@]}"}
    local name=${1:-}
    [ -n "$name" ] || usage_error "milestone start needs a milestone name"
    [ $# -le 1 ] || usage_error "milestone start takes one milestone name, got: $*"
    require_repo
    require_project
    load_milestone "$name"

    local primary existing
    primary=$(primary_worktree) || refuse \
        "could not read this repository's worktree list" \
        "git's own error is above."
    existing=$(worktree_for_branch "$MILESTONE_BRANCH") || refuse \
        "could not read this repository's worktree list" \
        "git's own error is above."

    # Already checked out somewhere. Idempotent — except in the one place it
    # must never be, where reporting it as fine would bless the hazard.
    if [ -n "$existing" ]; then
        [ "$existing" != "$primary" ] || refuse_milestone "$MILESTONE_NAME" \
            "$MILESTONE_BRANCH is checked out in the primary checkout $primary" \
            "The milestone branch must never be the primary checkout's branch: the" \
            "user works and runs from that tree, and a milestone's half-integrated" \
            "state has taken down a running service from exactly there." \
            "" \
            "Put it back and re-run:" \
            "" \
            "    git -C \"$primary\" checkout main" \
            "    $PROG milestone start \"$MILESTONE_NAME\" -p $PROJECT"

        # The state a crash plus a cleanup leaves behind. Reporting the path
        # would hand the caller something it cannot cd into, and git will refuse
        # to check the branch out anywhere else while the registration stands.
        # Clearing it is a repair, not a setup step, so this refuses rather than
        # pruning: the guard's whole job is to stop and say what is true.
        read_prune_instructions
        ! worktree_missing "$existing" || refuse_milestone "$MILESTONE_NAME" \
            "$MILESTONE_BRANCH is registered to $existing, which no longer exists" \
            "${PRUNE_INSTRUCTIONS[@]}" \
            "    $PROG milestone start \"$MILESTONE_NAME\" -p $PROJECT"

        say "$existing"
        instruct "$MILESTONE_BRANCH is already checked out there; nothing to do."
        board_record_milestone "$MILESTONE_NAME" \
            "already started ($MILESTONE_BRANCH at $existing)"
        exit 0
    fi

    local path at_path
    path="$primary-${MILESTONE_BRANCH#milestone/}"

    # A live worktree of this repository already sitting there, just not on the
    # milestone branch — detached after a bisect, or left on another branch.
    # Told to "move it aside", an operator would break git's registration and
    # land in a worse state than the one they started in.
    at_path=$(worktree_head "$path") || refuse \
        "could not read this repository's worktree list" "git's own error is above."
    [ -z "$at_path" ] || refuse_milestone "$MILESTONE_NAME" \
        "$path is already a worktree of this repository, $(worktree_head_desc "$at_path")" \
        "That is where $MILESTONE_BRANCH belongs, and that is not what is checked" \
        "out there. Check it out where it belongs:" \
        "" \
        "    git -C \"$path\" checkout $MILESTONE_BRANCH"

    # -L as well as -e: a dangling symlink is invisible to -e, and letting the
    # worktree add fail on it would report git's error instead of this guard's.
    { [ ! -e "$path" ] && [ ! -L "$path" ]; } || refuse_milestone "$MILESTONE_NAME" \
        "$path already exists and is not a worktree for $MILESTONE_BRANCH" \
        "That is where this milestone's worktree belongs. Refusing rather than" \
        "reusing or removing it — whatever is there was put there by someone." \
        "" \
        "Inspect it, then move it aside or run \`git worktree prune\` if it is a" \
        "leftover, and re-run."

    local outcome
    if have_branch "$MILESTONE_BRANCH"; then
        # The branch outlived its worktree — adopt it. Recreating it would
        # discard whatever it already carries.
        announce "adding a worktree at $path for the existing branch $MILESTONE_BRANCH@$(short_sha "$MILESTONE_BRANCH")"
        # The bare branch name is deliberate here, and the one place in this
        # script that does not spell a ref `refs/heads/`. `git worktree add`
        # treats a full ref as a commit and checks it out detached; only the
        # bare name makes the new worktree sit *on* the branch.
        gitr worktree add "$path" "$MILESTONE_BRANCH" >&2 || refuse_milestone "$MILESTONE_NAME" \
            "git could not add a worktree at $path for $MILESTONE_BRANCH" \
            "git's own error is above. The branch was not created by this step, so" \
            "nothing about it has changed."
        outcome="adopted"
    else
        have_branch main || refuse_milestone "$MILESTONE_NAME" \
            "there is no main branch to create $MILESTONE_BRANCH from" \
            "The integration branch starts at main. This repository has no local" \
            "main, so there is nothing to branch off."
        announce "creating $MILESTONE_BRANCH off main@$(short_sha main) and checking it out at $path"
        gitr worktree add -b "$MILESTONE_BRANCH" "$path" refs/heads/main >&2 ||
            refuse_milestone "$MILESTONE_NAME" \
                "git could not create $MILESTONE_BRANCH at $path" \
                "git's own error is above. git creates the branch before it checks" \
                "it out, so $MILESTONE_BRANCH may exist even though the worktree" \
                "does not:" \
                "" \
                "    git -C \"$REPO\" branch --list $MILESTONE_BRANCH"
        outcome="created"
    fi

    say "$path"
    instruct "The primary checkout $primary was not touched."
    board_record_milestone "$MILESTONE_NAME" "$outcome ($MILESTONE_BRANCH at $path)"
    exit 0
}

# milestone finish <NAME> [-p KEY] — the one cutover: main only moves by a
# fast-forward to the already-serialized milestone branch.
cmd_milestone_finish() {
    parse_project_option "$@"
    set -- ${ARGS_REST[@]+"${ARGS_REST[@]}"}
    local name=${1:-}
    [ -n "$name" ] || usage_error "milestone finish needs a milestone name"
    [ $# -le 1 ] || usage_error "milestone finish takes one milestone name, got: $*"
    require_repo
    require_project
    load_milestone "$name"

    local unsettled
    unsettled=$(unsettled_milestone_issues) || refuse_milestone "$MILESTONE_NAME" \
        "could not list the issues in milestone \"$MILESTONE_NAME\"" \
        "The board must be readable before main can move. Retry the command."
    [ -z "$unsettled" ] || refuse_milestone "$MILESTONE_NAME" \
        "milestone \"$MILESTONE_NAME\" still has unsettled issues: $unsettled" \
        "Finish or explicitly discard them, then retry."

    have_branch main || refuse_milestone "$MILESTONE_NAME" \
        "the local main branch does not exist" \
        "This command only fast-forwards main; restore or create the intended main first."
    have_branch "$MILESTONE_BRANCH" || refuse_milestone "$MILESTONE_NAME" \
        "the milestone branch $MILESTONE_BRANCH does not exist here" \
        "Start it first: $PROG milestone start \"$MILESTONE_NAME\" -p $PROJECT"
    is_ancestor main "$MILESTONE_BRANCH" || refuse_milestone "$MILESTONE_NAME" \
        "main is not an ancestor of $MILESTONE_BRANCH (main drift)" \
        "Merge main into $MILESTONE_BRANCH via a dispatched agent in the milestone" \
        "worktree, resolve and verify there, then retry. The orchestrator must not resolve it."

    local tip verified_tip
    tip=$(full_sha "$MILESTONE_BRANCH")
    if [ "$tip" != "$(full_sha main)" ]; then
        verified_tip=$(gitr log -1 --format=%H --grep='^Ticket: ' "refs/heads/$MILESTONE_BRANCH")
        [ "$tip" = "$verified_tip" ] || refuse_milestone "$MILESTONE_NAME" \
            "$MILESTONE_BRANCH@$tip differs from the last verified ticket integration ${verified_tip:-none}" \
            "Put the shared change through a dispatched ticket, then sync, verify, ready, and integrate it."
    fi

    local primary head
    primary=$(primary_worktree) || refuse \
        "could not read this repository's worktree list" "git's own error is above."
    head=$(worktree_head "$primary") || refuse \
        "could not read this repository's worktree list" "git's own error is above."
    [ "$head" = main ] || refuse_milestone "$MILESTONE_NAME" \
        "the primary checkout $primary is $(worktree_head_desc "$head"), not on main" \
        "Switch that checkout to main before finishing the milestone."
    ! worktree_dirty "$primary" || refuse_milestone "$MILESTONE_NAME" \
        "the primary checkout $primary has uncommitted changes" \
        "Commit or stash them before fast-forwarding main."

    announce "fast-forwarding main to $MILESTONE_BRANCH@$tip"
    git -C "$primary" merge --ff-only "refs/heads/$MILESTONE_BRANCH" >&2 || refuse_milestone "$MILESTONE_NAME" \
        "git could not fast-forward main to $MILESTONE_BRANCH" \
        "Git's own error is above. Nothing here will attempt a non-fast-forward merge."
    board_record_milestone "$MILESTONE_NAME" "finished (main at $tip from $MILESTONE_BRANCH)"
    say "$tip"
}

# ticket start <KEY> — the ticket's worktree, under the milestone's.
#
# Rooted at <milestone worktree>/.worktrees/<git_branch_name>, and branched off
# the milestone branch's tip *as it is now*: ticket worktrees are made at wave
# time, so each one starts from everything already integrated rather than from
# wherever the milestone began.
#
# Under the milestone worktree rather than beside the primary checkout so that
# the milestone's build state — every ticket's target directory, every
# node_modules — stays out of the tree the user works and runs from.
START_NEW_CLAIM=0 START_STATUS_CHANGED=0 START_ORIGINAL_STATUS=""
start_ticket_on_board() {
    START_NEW_CLAIM=0 START_STATUS_CHANGED=0 START_ORIGINAL_STATUS=$ISSUE_STATUS
    cliban issue claim "$ISSUE_KEY" >/dev/null 2>&1 || refuse_ticket "$ISSUE_KEY" \
        "$ISSUE_KEY is claimed by another actor" \
        "Have its owner release it: cliban issue release $ISSUE_KEY"
    [ -n "$ISSUE_CLAIMED_BY" ] || START_NEW_CLAIM=1
    [ "$ISSUE_STATUS" = in-progress ] || START_STATUS_CHANGED=1
    cliban issue mv "$ISSUE_KEY" in-progress >/dev/null 2>&1 || {
        rollback_ticket_start
        refuse_ticket "$ISSUE_KEY" \
            "$ISSUE_KEY could not move to in-progress" \
            "Inspect the board: cliban issue show $ISSUE_KEY --json"
    }
}

rollback_ticket_start() {
    [ "$START_STATUS_CHANGED" -eq 0 ] ||
        cliban issue mv "$ISSUE_KEY" "$START_ORIGINAL_STATUS" >/dev/null 2>&1 ||
        warn "could not restore $ISSUE_KEY to $START_ORIGINAL_STATUS"
    [ "$START_NEW_CLAIM" -eq 0 ] ||
        cliban issue release "$ISSUE_KEY" >/dev/null 2>&1 ||
        warn "could not release $ISSUE_KEY after start failed"
}

cmd_ticket_start() {
    local key=${1:-}
    [ -n "$key" ] || usage_error "ticket start needs an issue key"
    [ $# -le 1 ] || usage_error "ticket start takes one issue key, got: $*"
    require_repo
    load_issue "$key"

    load_ticket_milestone_branch "it has nothing to branch from" \
        "A ticket branch starts at its milestone's tip and its worktree hangs off" \
        "the milestone's. Put the ticket on a milestone first:"

    local mbranch start_milestone
    mbranch=$TICKET_MBRANCH
    start_milestone="    $PROG milestone start \"$ISSUE_MILESTONE\" -p $ISSUE_PROJECT"

    local primary mwt
    primary=$(primary_worktree) || refuse \
        "could not read this repository's worktree list" "git's own error is above."
    mwt=$(worktree_for_branch "$mbranch") || refuse \
        "could not read this repository's worktree list" "git's own error is above."

    if [ -z "$mwt" ]; then
        # The milestone's worktree may well be right where it belongs and simply
        # not on the branch. Sending someone to `milestone start` here would
        # bounce them into the occupied-path refusal and back, and neither
        # message would name the state they are actually in.
        local mpath at_mpath
        mpath="$primary-${mbranch#milestone/}"
        at_mpath=$(worktree_head "$mpath") || refuse \
            "could not read this repository's worktree list" "git's own error is above."
        [ -z "$at_mpath" ] || refuse_ticket "$ISSUE_KEY" \
            "the milestone worktree $mpath is $(worktree_head_desc "$at_mpath"), not on $mbranch" \
            "$ISSUE_BRANCH starts at $mbranch's tip and its worktree is rooted under" \
            "that one. Put it back on the branch:" \
            "" \
            "    git -C \"$mpath\" checkout $mbranch"

        refuse_ticket "$ISSUE_KEY" \
            "$mbranch exists but is checked out in no worktree" \
            "Ticket worktrees are rooted under the milestone's worktree, and this" \
            "milestone does not have one. Make it:" \
            "" \
            "$start_milestone"
    fi

    [ "$mwt" != "$primary" ] || refuse_ticket "$ISSUE_KEY" \
        "$mbranch is checked out in the primary checkout $primary" \
        "Ticket worktrees are rooted under the milestone worktree, so this would" \
        "put every ticket's build state inside the tree the user works and runs" \
        "from — the layout that has already taken down a running service." \
        "" \
        "Give the milestone its own worktree first:" \
        "" \
        "    git -C \"$primary\" checkout main" \
        "$start_milestone"

    read_prune_instructions

    ! worktree_missing "$mwt" || refuse_ticket "$ISSUE_KEY" \
        "$mbranch is registered to $mwt, which no longer exists" \
        "${PRUNE_INSTRUCTIONS[@]}" \
        "$start_milestone"

    ! worktree_dirty "$mwt" || refuse_ticket "$ISSUE_KEY" \
        "the milestone worktree $mwt has uncommitted changes" \
        "$ISSUE_BRANCH would start at $mbranch's tip, which is not what is in that" \
        "tree — whatever is uncommitted there would silently not be in it. Commit" \
        "or stash it first:" \
        "" \
        "    git -C \"$mwt\" status"

    # Nothing this subcommand creates may land outside the milestone worktree.
    # The name comes from the board, and a guard that trusts its input is not a
    # guard; this one is checked before anything is announced or created.
    local root path
    root="$mwt/.worktrees"
    path="$root/$ISSUE_BRANCH"

    # path_within compares paths as written, which a symlink makes a lie: every
    # ticket worktree would land outside the milestone root while spelling as if
    # it were inside. Refusing rather than resolving it, because a resolved path
    # would be *correctly* outside the root, which is the thing forbidden.
    [ ! -L "$root" ] || refuse_ticket "$ISSUE_KEY" \
        "$root is a symlink, so a worktree under it would not be inside $mwt" \
        "Ticket worktrees have to stay within the milestone worktree. Replace the" \
        "symlink with a real directory, or move the milestone worktree itself to" \
        "wherever you wanted its contents to live."

    path_within "$root" "$path" || refuse_ticket "$ISSUE_KEY" \
        "$ISSUE_KEY's branch name puts its worktree outside $root" \
        "\`git_branch_name\` is \"$ISSUE_BRANCH\", which resolves out of the" \
        "milestone worktree. Nothing was created. cliban does not produce names" \
        "like this, so the board is reporting something it should not."

    local existing
    existing=$(worktree_for_branch "$ISSUE_BRANCH") || refuse \
        "could not read this repository's worktree list" "git's own error is above."

    if [ -n "$existing" ]; then
        # The same hazard as the milestone branch in the primary checkout, one
        # level down and easier to reach: someone checks the ticket branch out
        # there to look at it, and a later `ticket start` would hand that path
        # back to a caller whose next step is to cd in and build.
        [ "$existing" != "$primary" ] || refuse_ticket "$ISSUE_KEY" \
            "$ISSUE_BRANCH is checked out in the primary checkout $primary" \
            "Reporting that as this ticket's worktree would send whoever asked" \
            "into the tree the user works and runs from. Free the branch first:" \
            "" \
            "    git -C \"$primary\" checkout main" \
            "    $PROG ticket start $ISSUE_KEY"

        ! worktree_missing "$existing" || refuse_ticket "$ISSUE_KEY" \
            "$ISSUE_BRANCH is registered to $existing, which no longer exists" \
            "${PRUNE_INSTRUCTIONS[@]}" \
            "    $PROG ticket start $ISSUE_KEY"
        start_ticket_on_board
        say "$existing"
        instruct "$ISSUE_BRANCH is already checked out there; nothing to do."
        board_record "$ISSUE_KEY" "already started ($ISSUE_BRANCH at $existing)"
        exit 0
    fi

    { [ ! -e "$path" ] && [ ! -L "$path" ]; } || refuse_ticket "$ISSUE_KEY" \
        "$path already exists and is not a worktree for $ISSUE_BRANCH" \
        "That is where this ticket's worktree belongs. Refusing rather than" \
        "reusing or removing it — whatever is there was put there by someone." \
        "" \
        "Inspect it, then move it aside or run \`git worktree prune\` if it is a" \
        "leftover, and re-run."

    start_ticket_on_board

    local outcome
    if have_branch "$ISSUE_BRANCH"; then
        # The branch outlived its worktree and carries work. Recreating it off
        # the milestone tip would throw that away without saying so.
        announce "adding a worktree at $path for the existing branch $ISSUE_BRANCH@$(short_sha "$ISSUE_BRANCH")"
        if ! gitr worktree add "$path" "$ISSUE_BRANCH" >&2; then
            rollback_ticket_start
            refuse_ticket "$ISSUE_KEY" \
                "git could not add a worktree at $path for $ISSUE_BRANCH" \
                "git's own error is above. The branch was not created by this step."
        fi
        outcome="adopted"
    else
        announce "creating $ISSUE_BRANCH off $mbranch@$(short_sha "$mbranch") and checking it out at $path"
        if ! gitr worktree add -b "$ISSUE_BRANCH" "$path" "refs/heads/$mbranch" >&2; then
            rollback_ticket_start
            refuse_ticket "$ISSUE_KEY" \
                "git could not create $ISSUE_BRANCH at $path" \
                "git's own error is above. git creates the branch before it checks" \
                "it out, so $ISSUE_BRANCH may exist even though the worktree does" \
                "not:" \
                "" \
                "    git -C \"$REPO\" branch --list $ISSUE_BRANCH"
        fi
        outcome="created"
    fi

    say "$path"
    instruct "The primary checkout $primary was not touched."
    board_record "$ISSUE_KEY" "$outcome ($ISSUE_BRANCH at $path)"
    exit 0
}

cmd_ticket_status() {
    local key=${1:-}
    [ -n "$key" ] || usage_error "ticket status needs an issue key"
    [ $# -le 1 ] || usage_error "ticket status takes one issue key, got: $*"
    require_repo
    load_issue "$key"

    load_ticket_milestone_branch "it has no integration target" \
        "Mergeability is a question about a milestone branch. Put the ticket on a" \
        "milestone first:"
    require_ticket_branch

    local mbranch msha tsha
    mbranch=$TICKET_MBRANCH
    msha=$(short_sha "$mbranch")
    tsha=$(short_sha "$ISSUE_BRANCH")

    if is_ancestor "$mbranch" "$ISSUE_BRANCH"; then
        say "mergeable"
        instruct "$mbranch@$msha is an ancestor of $ISSUE_BRANCH@$tsha."
        board_record "$ISSUE_KEY" \
            "mergeable ($mbranch@$msha is an ancestor of $ISSUE_BRANCH@$tsha)"
        exit 0
    fi

    say "sync-required: $mbranch@$msha is not an ancestor of $ISSUE_BRANCH"
    instruct \
        "$ISSUE_BRANCH is at $tsha and does not contain the milestone tip." \
        "" \
        "The agent implementing $ISSUE_KEY brings it forward and resolves whatever" \
        "that surfaces:" \
        "" \
        "    cliban-flow ticket sync $ISSUE_KEY" \
        "    <re-run this repo's build and its full test suite>" \
        "    cliban-flow ticket ready $ISSUE_KEY" \
        "" \
        "The orchestrator must not resolve this itself. Integration squashes the" \
        "ticket branch's tree unbuilt and untested, which is only safe while that" \
        "tree is the one the implementer built and tested; a merge performed here" \
        "would produce a tree nobody has ever run." \
        ""
    board_record "$ISSUE_KEY" \
        "sync-required ($mbranch@$msha is not an ancestor of $ISSUE_BRANCH@$tsha)"
    exit 1
}

# ticket sync <KEY> — bring the ticket branch up to the milestone tip.
#
# A merge, never a rebase. Rebase rewrites the very commits the integration gate
# reads, so a rebased branch has to be re-verified from nothing, and it replays
# one collision once per commit rather than once.
#
# The merge runs in the ticket's own worktree, and a conflict is deliberately
# left in progress there rather than aborted: the half-merged index is the state
# the implementer resolves it in, and throwing it away would discard the only
# part of this that needs a person.
#
# This is the one subcommand whose failure is routinely not a refusal. A
# conflict is what a correct merge of two correct branches does — a real outcome
# of a question properly asked — so it exits 1, with the unmerged paths on
# stdout because that is the answer.
cmd_ticket_sync() {
    local key=${1:-}
    [ -n "$key" ] || usage_error "ticket sync needs an issue key"
    [ $# -le 1 ] || usage_error "ticket sync takes one issue key, got: $*"
    require_repo
    load_issue "$key"

    load_ticket_milestone_branch "there is nothing to bring it up to date with" \
        "Syncing is merging a milestone branch in, so there has to be one. Put" \
        "the ticket on a milestone first:"
    require_ticket_branch
    load_ticket_worktree

    local mbranch=$TICKET_MBRANCH
    local msha tsha
    msha=$(short_sha "$mbranch")
    tsha=$(short_sha "$ISSUE_BRANCH")

    # Already carrying the tip: the state a re-run finds, and the state a ticket
    # started this wave is in. Merging anyway would manufacture an empty merge
    # commit for the sake of having something to report.
    if is_ancestor "$mbranch" "$ISSUE_BRANCH"; then
        say "$(full_sha "$ISSUE_BRANCH")"
        instruct \
            "$ISSUE_BRANCH@$tsha already contains $mbranch@$msha; nothing to merge." \
            "" \
            "That is the state \`ticket ready\` requires, so if the build and the" \
            "full suite are green on this tree:" \
            "" \
            "    $PROG ticket ready $ISSUE_KEY"
        board_record "$ISSUE_KEY" \
            "already up to date ($ISSUE_BRANCH@$tsha already contains $mbranch@$msha)"
        exit 0
    fi

    announce "merging $mbranch@$msha into $ISSUE_BRANCH@$tsha in $TICKET_WT"
    # refs/heads, like every other lookup here: a tag sharing the milestone
    # branch's name would otherwise be what got merged, and the branch this
    # reports having merged would not be the one it did.
    #
    # -m rather than git's default message, so the commit says which branch went
    # into which and a conflicted merge's MERGE_MSG says it too — that is the
    # message the implementer's own `git commit` will use.
    if git -C "$TICKET_WT" merge --no-edit \
        -m "Merge $mbranch into $ISSUE_BRANCH" "refs/heads/$mbranch" >&2; then

        local after ff=""
        after=$(full_sha "$ISSUE_BRANCH")
        # A fast-forward lands exactly on the milestone tip; a merge commit
        # cannot. Worth distinguishing on the board: one means the ticket had no
        # commits of its own, which is a fact about the ticket.
        [ "$after" != "$(full_sha "$mbranch")" ] || ff=", fast-forward"

        say "$after"
        instruct \
            "$ISSUE_BRANCH is now at $(short_sha "$ISSUE_BRANCH") and contains $mbranch@$msha." \
            "" \
            "Nothing has built or tested that tree. This tool does not run builds:" \
            "which commands they are varies per repository and reading their output" \
            "is judgement. Integration then squashes this tree unbuilt and untested," \
            "on the strength of your having done it here:" \
            "" \
            "    <this repository's build>" \
            "    <this repository's full test suite>" \
            "    $PROG ticket ready $ISSUE_KEY"
        board_record "$ISSUE_KEY" \
            "merged ($mbranch@$msha into $ISSUE_BRANCH@$tsha, clean$ff, now at $(short_sha "$ISSUE_BRANCH"))"
        exit 0
    fi

    # git failed. A conflict leaves unmerged entries in the index; anything else
    # — a merge it refused to start, a repository it could not read — leaves
    # none, and is not this subcommand's expected outcome.
    local unmerged
    unmerged=$(git -C "$TICKET_WT" diff --name-only --diff-filter=U 2>/dev/null) || unmerged=""
    [ -n "$unmerged" ] || refuse_ticket "$ISSUE_KEY" \
        "git could not merge $mbranch into $ISSUE_BRANCH, and left no conflict to resolve" \
        "git's own error is above. This is not the ordinary conflicting merge —" \
        "that leaves unmerged paths in the index and this left none — so check" \
        "what state the worktree is in before doing anything else:" \
        "" \
        "    git -C \"$TICKET_WT\" status"

    say "$unmerged"
    instruct \
        "The paths on stdout could not be merged. The merge is in progress in" \
        "$TICKET_WT." \
        "" \
        "The agent implementing $ISSUE_KEY resolves this." \
        "" \
        "The orchestrator will not do it: it has no knowledge of what either" \
        "colliding ticket intended, and a resolution made there would produce a" \
        "tree nobody has built or tested — exactly what integration is not" \
        "allowed to squash." \
        "" \
        "    git -C \"$TICKET_WT\" status" \
        "    # resolve each path, then" \
        "    git -C \"$TICKET_WT\" add <path>..." \
        "    git -C \"$TICKET_WT\" commit" \
        "" \
        "Then log what you resolved and why. The resolution is the part of this" \
        "that outlives you, and it is what a review of the resolution diff reads:" \
        "" \
        "    cliban issue log $ISSUE_KEY \"resolved <paths> against $mbranch: <how>\"" \
        "" \
        "Then build, run the full suite, and:" \
        "" \
        "    $PROG ticket ready $ISSUE_KEY" \
        ""
    board_record "$ISSUE_KEY" \
        "conflicted ($mbranch@$msha into $ISSUE_BRANCH@$tsha, unmerged: $(printf '%s' "$unmerged" | tr '\n' ' ' | sed 's/ $//'))"
    exit 1
}

# ticket ready <KEY> — hand the branch over, as a board state.
#
# Ready is not a message and not a claim made in prose: `in-review` is what it
# means, and the orchestrator never looks at a branch whose ticket is not in
# that state. So this subcommand is mostly its guards — everything an
# orchestrator would otherwise have to re-check, checked once, here, by the only
# context that knows what the branch was supposed to do.
#
# The move is the deliverable, which makes it the one board write in this script
# that may not degrade to a warning. An activity-log line that failed to append
# leaves an audit trail with a hole in it; a transition that failed to apply and
# reported success leaves a finished branch nobody will ever look at, and
# nothing anywhere saying so.
cmd_ticket_ready() {
    local key=${1:-}
    [ -n "$key" ] || usage_error "ticket ready needs an issue key"
    [ $# -le 1 ] || usage_error "ticket ready takes one issue key, got: $*"
    require_repo
    load_issue "$key"

    [ "$ISSUE_STATUS" != "done" ] || refuse_ticket "$ISSUE_KEY" \
        "$ISSUE_KEY is already done, so it cannot be handed over again" \
        "Inspect it: cliban issue show $ISSUE_KEY --json"

    load_ticket_milestone_branch "there is no tip it could be checked against" \
        "Ready means the branch contains its milestone's tip, which needs a" \
        "milestone. Put the ticket on one first:"
    require_ticket_branch
    load_ticket_worktree

    local mbranch=$TICKET_MBRANCH
    local msha tsha
    msha=$(short_sha "$mbranch")
    tsha=$(short_sha "$ISSUE_BRANCH")

    # The same test `ticket status` reports on and `milestone integrate` will
    # gate on: strict ancestry, never a trial merge. A branch that is merely
    # behind would merge cleanly and is still not ready, because the tree that
    # would land is not the tree that was built and tested.
    is_ancestor "$mbranch" "$ISSUE_BRANCH" || refuse_ticket "$ISSUE_KEY" \
        "$mbranch@$msha is not an ancestor of $ISSUE_BRANCH@$tsha" \
        "Ready means integrable, and integration squashes this branch's tree" \
        "unbuilt and untested — which is only safe while that tree is the one you" \
        "built and tested. A branch that is behind is not that tree, however" \
        "cleanly it would merge. Bring it forward, re-run the build and the full" \
        "suite on what comes out, and come back:" \
        "" \
        "    $PROG ticket sync $ISSUE_KEY" \
        "    <this repository's build>" \
        "    <this repository's full test suite>" \
        "    $PROG ticket ready $ISSUE_KEY"

    local plan activity
    plan=$(cliban issue cat "$ISSUE_KEY" --section plan 2>/dev/null) || refuse_ticket "$ISSUE_KEY" \
        "$ISSUE_KEY has no plan on the board" \
        "Create it: cliban issue edit $ISSUE_KEY --section plan --create-section --description-file -"
    printf '%s\n' "$plan" | grep -Eq '^- \[[ xX]\] ' || refuse_ticket "$ISSUE_KEY" \
        "$ISSUE_KEY's plan has no checklist items" \
        "Add one: cliban issue edit $ISSUE_KEY --section plan --description-file -"

    [ "$(gitr rev-list --count "refs/heads/$mbranch..refs/heads/$ISSUE_BRANCH")" -gt 0 ] || refuse_ticket "$ISSUE_KEY" \
        "$ISSUE_BRANCH has no commits past $mbranch" \
        "Commit the ticket work: git -C \"$TICKET_WT\" commit"

    activity=$(cliban issue cat "$ISSUE_KEY" --section activity 2>/dev/null) || activity=""
    printf '%s\n' "$activity" | grep -Eqi 'review.*SPEC.*QUALITY' || refuse_ticket "$ISSUE_KEY" \
        "$ISSUE_KEY has no recorded review verdict" \
        "Record it after review: cliban issue log $ISSUE_KEY \"<SPEC and QUALITY verdict>\""

    local tip
    tip=$(full_sha "$ISSUE_BRANCH")
    local detail="$ISSUE_BRANCH@$tsha contains $mbranch@$msha"

    # Already there. Re-running must not depend on cliban's handling of a move
    # to the status something is already in, and must not read as a second
    # handoff on the board.
    if [ "$ISSUE_STATUS" = in-review ]; then
        say "$tip"
        instruct "$ISSUE_KEY is already in-review; nothing to move." \
            "" \
            "$detail, and its worktree is clean."
        board_record "$ISSUE_KEY" "already ready ($detail)"
        exit 0
    fi

    announce "moving $ISSUE_KEY to in-review at $ISSUE_BRANCH@$tsha"
    cliban issue mv "$ISSUE_KEY" in-review \
        --note "$(board_line "$ISSUE_KEY" "ready ($detail)")" >/dev/null 2>&1 ||
        refuse_ticket "$ISSUE_KEY" \
            "could not move $ISSUE_KEY to in-review on the board" \
            "The branch is fine — this is the board write that failed, and ready is" \
            "a board state, so nothing has been handed over. An orchestrator only" \
            "looks at tickets in in-review, so reporting success here would strand" \
            "$ISSUE_BRANCH silently. Check the board and re-run:" \
            "" \
            "    cliban issue show $ISSUE_KEY" \
            "    $PROG ticket ready $ISSUE_KEY"

    say "$tip"
    instruct \
        "$ISSUE_KEY is in-review and $detail." \
        "" \
        "The orchestrator integrates from here and owns the move to done. It" \
        "will not build or test what it squashes, so whatever you ran on this" \
        "tree is the last thing that did." \
        ""
    board_record "$ISSUE_KEY" "ready ($detail)"
    exit 0
}

# ticket integrate <KEY> [--dry-run] — serialize one tested ticket tree onto
# the milestone branch as one squash commit. Strict ancestry makes that tree
# byte-identical to the one the implementer tested; this command never builds.
cmd_ticket_integrate() {
    local key=${1:-} dry_run=0
    [ -n "$key" ] || usage_error "ticket integrate needs an issue key"
    shift
    if [ "${1:-}" = --dry-run ]; then dry_run=1; shift; fi
    [ $# -eq 0 ] || usage_error "ticket integrate takes one issue key and optional --dry-run, got: $key $*"
    require_repo
    load_issue "$key"

    [ "$ISSUE_STATUS" = in-review ] || refuse_ticket "$ISSUE_KEY" \
        "$ISSUE_KEY is $ISSUE_STATUS, not in-review" \
        "The implementer must finish, sync, test, and hand off the branch first:" \
        "" \
        "    $PROG ticket ready $ISSUE_KEY"
    load_ticket_milestone_branch "it has no integration target" \
        "Put the ticket on the milestone it should integrate into first:"
    require_ticket_branch
    load_ticket_worktree

    local mbranch=$TICKET_MBRANCH mtip ttip mwt subject subjects
    mtip=$(full_sha "$mbranch")
    ttip=$(full_sha "$ISSUE_BRANCH")

    have_branch main || refuse_ticket "$ISSUE_KEY" \
        "the local main branch does not exist" \
        "This protocol lands the milestone by fast-forwarding main, so main must" \
        "exist before a ticket can be integrated."
    is_ancestor main "$mbranch" || refuse_ticket "$ISSUE_KEY" \
        "main is not an ancestor of $mbranch (main drift)" \
        "Merge main into $mbranch via a dispatched agent in the milestone worktree," \
        "resolve and verify it there, then retry. The orchestrator must not resolve it."
    is_ancestor "$mbranch" "$ISSUE_BRANCH" || refuse_ticket "$ISSUE_KEY" \
        "$mbranch@$(short_sha "$mbranch") is not an ancestor of $ISSUE_BRANCH@$(short_sha "$ISSUE_BRANCH")" \
        "The agent implementing $ISSUE_KEY must sync, resolve, build, test, and" \
        "hand the branch back:" \
        "" \
        "    $PROG ticket sync $ISSUE_KEY" \
        "    <re-run this repo's build and its full test suite>" \
        "    $PROG ticket ready $ISSUE_KEY" \
        "" \
        "The orchestrator must not resolve this itself."

    subject="$ISSUE_KEY: $ISSUE_TITLE"
    if [ "$dry_run" -eq 1 ]; then
        say "mergeable: $mbranch@$mtip is an ancestor of $ISSUE_BRANCH@$ttip"
        say "squash: $subject"
        say "milestone: $mbranch@$mtip"
        say "ticket: $ISSUE_BRANCH@$ttip"
        exit 0
    fi

    mwt=$(worktree_for_branch "$mbranch") || refuse \
        "could not read this repository's worktree list" "git's own error is above."
    [ -n "$mwt" ] || refuse_ticket "$ISSUE_KEY" \
        "$mbranch is checked out in no worktree" \
        "Start the milestone worktree first: $PROG milestone start \"$ISSUE_MILESTONE\" -p $ISSUE_PROJECT"
    ! worktree_dirty "$mwt" || refuse_ticket "$ISSUE_KEY" \
        "the milestone worktree $mwt has uncommitted changes" \
        "Commit or stash them before integrating another ticket."

    subjects=$(gitr log --reverse --format='- %s' "refs/heads/$mbranch..refs/heads/$ISSUE_BRANCH")
    announce "squashing $ISSUE_BRANCH@$ttip onto $mbranch@$mtip"
    git -C "$mwt" merge --squash "refs/heads/$ISSUE_BRANCH" >&2 || refuse_ticket "$ISSUE_KEY" \
        "git could not squash $ISSUE_BRANCH onto $mbranch" \
        "The index may contain a partial squash. Inspect $mwt; the orchestrator must not resolve it."
    git -C "$mwt" commit -m "$subject" -m "Discarded commit subjects:
$subjects" -m "Ticket: $ISSUE_KEY" >&2 || refuse_ticket "$ISSUE_KEY" \
        "git could not commit the squash for $ISSUE_KEY" \
        "The squash is staged in $mwt. Inspect it before retrying."

    local squash_sha now
    squash_sha=$(full_sha "$mbranch")
    now=$(full_sha "$ISSUE_BRANCH")
    [ "$now" = "$ttip" ] || refuse_ticket "$ISSUE_KEY" \
        "$ISSUE_BRANCH moved after integration started ($ttip -> $now)" \
        "$mbranch now contains squash $squash_sha of the earlier tip. Do not mark" \
        "$ISSUE_KEY done; inspect the late commit and repair deliberately."

    cliban issue mv "$ISSUE_KEY" "done" --note "squashed as $squash_sha" >/dev/null || refuse_ticket "$ISSUE_KEY" \
        "could not move $ISSUE_KEY to done after squash $squash_sha" \
        "The git commit exists; retry the board move before integrating anything else."
    cliban linear push "$ISSUE_KEY" >/dev/null 2>&1 || true
    gitr worktree remove "$TICKET_WT" >&2 || refuse_ticket "$ISSUE_KEY" \
        "could not remove ticket worktree $TICKET_WT" \
        "The squash and board move succeeded. Remove only that worktree manually."
    board_record "$ISSUE_KEY" "integrated ($ISSUE_BRANCH@$ttip as $squash_sha on $mbranch; branch retained)"
    say "$squash_sha"
}

# abandon_ticket <reason> — discard only clean git state; always release the
# board claim and record why. load_issue must have populated ISSUE_* first.
abandon_ticket() {
    local reason=$1 wt primary expected retained=""
    primary=$(primary_worktree) || refuse \
        "could not read this repository's worktree list" "git's own error is above."
    wt=$(worktree_for_branch "$ISSUE_BRANCH") || refuse \
        "could not read this repository's worktree list" "git's own error is above."

    if [ -n "$wt" ]; then
        if [ "$wt" = "$primary" ]; then
            retained="branch and primary worktree retained"
        elif worktree_missing "$wt"; then
            retained="missing worktree registration and branch retained"
        elif [ -z "$ISSUE_MILESTONE" ]; then
            retained="unscoped worktree and branch retained"
        elif expected="$primary-${ISSUE_MILESTONE:+$(slugify "$ISSUE_MILESTONE")}/.worktrees/$ISSUE_BRANCH" && [ "$wt" != "$expected" ]; then
            retained="foreign worktree and branch retained"
        elif worktree_dirty "$wt"; then
            retained="dirty worktree and branch retained"
        else
            announce "removing abandoned ticket worktree $wt"
            gitr worktree remove "$wt" >&2 || retained="worktree and branch retained after git refused removal"
        fi
    fi

    wt=$(worktree_for_branch "$ISSUE_BRANCH") || refuse \
        "could not read this repository's worktree list" "git's own error is above."
    if [ -z "$wt" ] && have_branch "$ISSUE_BRANCH"; then
        announce "deleting abandoned ticket branch $ISSUE_BRANCH"
        gitr branch -D "$ISSUE_BRANCH" >&2 || retained="branch retained after git refused deletion"
    fi

    cliban issue log "$ISSUE_KEY" "work discarded: $reason${retained:+; $retained}" >/dev/null || refuse_ticket "$ISSUE_KEY" \
        "could not record why $ISSUE_KEY was abandoned" \
        "The git cleanup may already be complete; retry to release the claim."
    cliban issue release "$ISSUE_KEY" >/dev/null || refuse_ticket "$ISSUE_KEY" \
        "could not release $ISSUE_KEY's claim" \
        "The discard is recorded; retry the command to release the claim."
    board_record "$ISSUE_KEY" "abandoned ($reason${retained:+; $retained})"
}

cmd_ticket_abandon() {
    local key=${1:-} reason=""
    [ -n "$key" ] || usage_error "ticket abandon needs an issue key"
    shift
    [ "${1:-}" = --confirm ] || usage_error "ticket abandon needs --confirm <reason>"
    reason=${2:-}
    [ -n "$reason" ] || usage_error "ticket abandon needs --confirm <reason>"
    [ $# -eq 2 ] || usage_error "ticket abandon takes one issue key and --confirm <reason>"
    require_repo
    load_issue "$key"
    abandon_ticket "$reason"
    say "${retained:-abandoned}"
}

cmd_milestone_abandon() {
    local name="" reason="" arg keys key mwt primary expected retained=""
    while [ $# -gt 0 ]; do
        arg=$1
        case $arg in
            -p | --project)
                [ $# -ge 2 ] || usage_error "$arg needs a project key"
                FLOW_PROJECT=$2; shift 2 ;;
            --project=*) FLOW_PROJECT=${arg#--project=}; shift ;;
            --confirm)
                [ $# -ge 2 ] || usage_error "milestone abandon needs --confirm <reason>"
                reason=$2; shift 2 ;;
            -*) usage_error "unknown option: $arg" ;;
            *)
                [ -z "$name" ] || usage_error "milestone abandon takes one milestone name"
                name=$arg; shift ;;
        esac
    done
    [ -n "$name" ] || usage_error "milestone abandon needs a milestone name"
    [ -n "$reason" ] || usage_error "milestone abandon needs --confirm <reason>"
    require_repo
    require_project
    load_milestone "$name"

    keys=$(cliban issue ls -p "$PROJECT" -m "$MILESTONE_NAME" --json | json_lines_field key) ||
        refuse_milestone "$MILESTONE_NAME" "could not list milestone tickets" \
            "No teardown ran; retry when the board is readable."
    while IFS= read -r key; do
        [ -n "$key" ] || continue
        load_issue "$key"
        abandon_ticket "$reason"
    done <<<"$keys"

    primary=$(primary_worktree) || refuse \
        "could not read this repository's worktree list" "git's own error is above."
    mwt=$(worktree_for_branch "$MILESTONE_BRANCH") || refuse \
        "could not read this repository's worktree list" "git's own error is above."
    if [ -n "$mwt" ]; then
        if [ "$mwt" = "$primary" ]; then
            retained="milestone branch and primary worktree retained"
        elif worktree_missing "$mwt"; then
            retained="missing milestone worktree registration and branch retained"
        elif expected="$primary-${MILESTONE_BRANCH#milestone/}" && [ "$mwt" != "$expected" ]; then
            retained="foreign milestone worktree and branch retained"
        elif worktree_dirty "$mwt"; then
            retained="dirty milestone worktree and branch retained"
        else
            announce "removing abandoned milestone worktree $mwt"
            gitr worktree remove "$mwt" >&2 || retained="milestone worktree and branch retained after git refused removal"
        fi
    fi
    mwt=$(worktree_for_branch "$MILESTONE_BRANCH") || refuse \
        "could not read this repository's worktree list" "git's own error is above."
    if [ -z "$mwt" ] && have_branch "$MILESTONE_BRANCH"; then
        announce "deleting abandoned milestone branch $MILESTONE_BRANCH"
        gitr branch -D "$MILESTONE_BRANCH" >&2 || retained="milestone branch retained after git refused deletion"
    fi
    board_record_milestone "$MILESTONE_NAME" "abandoned ($reason${retained:+; $retained})"
    say "${retained:-abandoned}"
}

main "$@"
