#!/usr/bin/env bash
# cliban-flow — the git-and-board half of the cliban workflow.
#
# Subcommands map one-to-one onto a board transition or a board-visible verdict.
# The script owns git and the board and nothing else: it never builds, never
# tests, and never interprets a build or test result. That line is deliberate —
# build commands vary per repo and reading their output is judgement, which
# belongs to the agent that called this, not to a shell script.
#
# EXIT CODES are a contract every subcommand keeps, because callers branch on
# them rather than on message text:
#
#   0  the action succeeded, or a read-only verdict is affirmative
#   1  the verdict is negative — a real, legitimate state that is not what was
#      asked for. Stdout names the command that changes it.
#   2  refused. A guard failed or the invocation was malformed, so the question
#      could not be answered at all. Nothing was changed.
#
# The verdict goes to stdout because it is the answer; refusals, warnings and
# instructions go to stderr.
#
# BOARD LINES. Every invocation that resolves a ticket appends one line to that
# ticket's activity log under the stable prefix "[cliban-flow]", in the shape
#
#   [cliban-flow] <group> <command> <KEY>: <outcome> (<detail>)
#
# so a compacted orchestrator, a recovery survey, or a test assertion can
# reconstruct what ran. An invocation that never resolves a ticket — a usage
# error, an unknown key — has no log to append to and prints only.

set -euo pipefail

PROG=cliban-flow
BOARD_PREFIX='[cliban-flow]'

# "<group> <command>", set by the dispatcher and used in every board line.
ACTION=""
# The repository every git call runs against; set by require_repo.
REPO=""
# The loaded ticket; set by load_issue.
ISSUE_KEY="" ISSUE_TITLE="" ISSUE_STATUS="" ISSUE_BRANCH="" ISSUE_MILESTONE=""

# ---------------------------------------------------------------- output

say() { printf '%s\n' "$*"; }
warn() { printf '%s: %s\n' "$PROG" "$*" >&2; }

# instruct <line>... — the "what to do next" that follows a verdict or refusal.
# Indented on stderr so it reads as guidance rather than as more output.
instruct() {
    local line
    for line in "$@"; do printf '  %s\n' "$line" >&2; done
}

# refuse <summary> <instruction>... — a guard failed. Nothing was changed.
refuse() {
    local summary=$1
    shift
    printf '%s: refused: %s\n' "$PROG" "$summary" >&2
    instruct "$@"
    exit 2
}

usage_error() {
    printf '%s: %s\n' "$PROG" "$1" >&2
    usage >&2
    exit 2
}

usage() {
    cat <<EOF
usage: cliban-flow <group> <command> [args]

  ticket status <KEY>   Is <KEY>'s branch integrable? Read-only: prints
                        "mergeable" (exit 0) when the milestone branch tip is
                        an ancestor of the ticket branch, "sync-required"
                        (exit 1) when it is not.

Exit codes: 0 affirmative or done, 1 a negative verdict with the fix printed,
2 refused — a guard failed and nothing was changed.
EOF
}

# ---------------------------------------------------------------- board
#
# The activity log is this system's audit trail: recovery reads it to work out
# where an interrupted milestone stands, and a behavioural scenario greps it to
# prove an orchestrator reached for the tool. It is not the authority on whether
# anything happened, so writing it is best-effort — an unreachable board must
# never turn a clean verdict into a failure, only into a warning.

# board_record <KEY> <outcome>... — one line, in the documented shape.
board_record() {
    local key=$1
    shift
    cliban issue log "$key" "$BOARD_PREFIX $ACTION $key: $*" >/dev/null 2>&1 ||
        warn "could not record on $key's activity log; the board is out of date"
}

# ---------------------------------------------------------------- git
#
# Everything runs as `git -C "$REPO"` rather than relying on the caller's cwd,
# so a subcommand cannot be talked into acting on whatever directory a shell
# happened to be left in.

require_repo() {
    REPO=$(git rev-parse --show-toplevel 2>/dev/null) || refuse \
        "not inside a git repository" \
        "cd into the repository, or into the ticket worktree, and try again."
}

gitr() { git -C "$REPO" "$@"; }

have_ref() { gitr rev-parse --verify --quiet "$1^{commit}" >/dev/null; }

short_sha() { gitr rev-parse --short "$1"; }

# is_ancestor <a> <b> — true when every commit of <a> is reachable from <b>.
# Strict ancestry is the whole gate: never a trial merge, because a trial merge
# answers "would this apply cleanly", and the question that matters is "was the
# tree that was tested the tree that will land".
is_ancestor() { gitr merge-base --is-ancestor "$1" "$2"; }

# ---------------------------------------------------------------- the board's issues

json_field() {
    python3 -c 'import json, sys
d = json.load(sys.stdin)
v = d.get(sys.argv[1])
sys.stdout.write("" if v is None else str(v))' "$1"
}

# load_issue <KEY> — populate the ISSUE_* globals, or refuse.
load_issue() {
    local json
    json=$(cliban issue show "$1" --json 2>/dev/null) || refuse \
        "no issue named $1 on the board" \
        "Check the key. If this is a scratch board, check CLIBAN_DB points at it."
    ISSUE_KEY=$1
    ISSUE_TITLE=$(printf '%s' "$json" | json_field title)
    ISSUE_STATUS=$(printf '%s' "$json" | json_field status)
    ISSUE_BRANCH=$(printf '%s' "$json" | json_field git_branch_name)
    ISSUE_MILESTONE=$(printf '%s' "$json" | json_field milestone)
}

# slugify <text> — cliban's own branch-name rules, reimplemented: lowercase,
# every run of non-alphanumerics collapsed to one dash, trimmed, capped at 60.
# cliban publishes `git_branch_name` for an issue but nothing equivalent for a
# milestone, so the milestone branch name is derived here and has to stay in
# step with git_branch_name() in crates/cliban/src/output.rs.
slugify() {
    printf '%s' "$1" |
        tr '[:upper:]' '[:lower:]' |
        sed -e 's/[^a-z0-9][^a-z0-9]*/-/g' -e 's/^-//' -e 's/-$//' |
        cut -c 1-60 |
        sed -e 's/-$//'
}

milestone_branch() { printf 'milestone/%s' "$(slugify "$1")"; }

# ---------------------------------------------------------------- dispatch
#
# One group per noun, one case arm per command. A new subcommand is one arm and
# one cmd_* function; nothing else moves.

ticket_dispatch() {
    local command=${1:-}
    if [ $# -gt 0 ]; then shift; fi
    case $command in
        status)
            ACTION="ticket status"
            cmd_ticket_status "$@"
            ;;
        '') usage_error "ticket needs a command" ;;
        *) usage_error "unknown ticket command: $command" ;;
    esac
}

main() {
    [ $# -gt 0 ] || { usage >&2; exit 2; }
    local group=$1
    shift
    case $group in
        help | -h | --help) usage ;;
        ticket) ticket_dispatch "$@" ;;
        *) usage_error "unknown command group: $group" ;;
    esac
}

# ---------------------------------------------------------------- commands

cmd_ticket_status() {
    local key=${1:-}
    [ -n "$key" ] || usage_error "ticket status needs an issue key"
    require_repo
    load_issue "$key"

    local mbranch
    mbranch=$(milestone_branch "$ISSUE_MILESTONE")

    local msha tsha
    msha=$(short_sha "$mbranch")
    tsha=$(short_sha "$ISSUE_BRANCH")

    if is_ancestor "$mbranch" "$ISSUE_BRANCH"; then
        say "mergeable"
        instruct "$mbranch@$msha is an ancestor of $ISSUE_BRANCH@$tsha."
        board_record "$ISSUE_KEY" \
            "mergeable ($mbranch@$msha is an ancestor of $ISSUE_BRANCH@$tsha)"
        exit 0
    fi
}

main "$@"
