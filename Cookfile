# Cookfile for cliban — release and packaging orchestration.
#
# The build itself is cargo's job. What lives here is everything around it that
# used to be manual and drifted: the version claimed in five places, the order
# the crates publish in, the checksums two downstream packages pin.
#
#   cook bump 0.3.0     rewrite every version claim, refresh Cargo.lock
#   cook check          the gate: version sync, installer lint, tests, clippy
#   cook release 0.3.0  tag and push (gated on check)
#   cook publish        push every workspace crate to crates.io, bottom-up
#   cook tap 0.3.0      regenerate the Homebrew formula, push the tap
#   cook aur 0.3.0      refresh the AUR checksums from the release
#   cook smoke-install  install from the live release into a sandbox
#
# A full release is: cook bump X → commit → cook release X → cook tap X,
# cook aur X, cook publish.

# Every file that claims a version. `bump` rewrites these, `version-sync` guards
# them, and sealing the set is what makes the guard re-run exactly when one moves.
files version:sites
    "Cargo.toml"
    "Cargo.lock"
    "crates/*/Cargo.toml"
    "packaging/aur/PKGBUILD"

# version-sync also asks whether each plugin tree moved since the last release,
# so every plugin source is an input to it, not just the manifest that claims a
# version. Sealed separately because these answer the other half of the
# question: not "what version is claimed" but "did this tree change at all".
#
# Found the hard way. With only version:sites sealed, editing a skill left the
# check cached green while it was really red, and `release` hangs off `check`.
files version:plugins
    "plugin/**"
    "plugin-flow/**"

# What the cargo suite actually depends on besides the sources. PKGBUILD is
# deliberately absent — an AUR edit should not invalidate the test suite.
files rust:manifests
    "Cargo.toml"
    "Cargo.lock"
    "crates/*/Cargo.toml"

tools rust:toolchain
    cargo

tools shell:linter
    shellcheck

# `bash -n` is a bash parse, so bash's own version determines the answer.
tools flow:linter
    bash
    shellcheck

# What the cliban-flow shell suite drives. cliban is in here deliberately: the
# suite asserts on what cliban writes to a board, so a new cliban is a reason to
# re-run it rather than replay a green from the last one. It is also why
# test-flow stays off `check` — see below.
tools flow:tools
    bash
    cliban
    git
    python3

tools node:toolchain
    node
    npm

# Build/test configuration the extension check reads but never iterates.
files vscode:config
    "editors/vscode/package.json"
    "editors/vscode/package-lock.json"
    "editors/vscode/tsconfig.json"
    "editors/vscode/esbuild.mjs"
    "editors/vscode/webview/styles.css"
    "editors/vscode/test/fixtures/fake-cliban.js"

# Source sets the one-unit recipes read without naming them in their commands.
files flow:sources
    "plugin-flow/scripts/cliban-flow"
    "plugin-flow/tests/*.sh"

files rust:sources
    "crates/**/*.rs"

files vscode:sources
    "editors/vscode/src/**/*.ts"
    "editors/vscode/shared/**/*.ts"
    "editors/vscode/webview/**/*.ts"
    "editors/vscode/test/**/*.ts"

# ---------------------------------------------------------------- gates

# The drift guard. v0.1.0 shipped a binary reporting the wrong version because
# nothing checked; this is that check.
recipe version-sync
    gather "scripts/check-version-sync.py"
    seal version:sites version:plugins
    test { python3 $<in> }

# install.sh is piped into `sh` by strangers, so it gets parsed and linted.
recipe lint-install
    gather "install.sh"
    seal shell:linter
    test { sh -n $<in> }
    test { shellcheck -s sh $<in> }

# The cliban-flow dispatcher drives git and the board unattended on an agent's
# behalf, so it gets the same parse-and-lint treatment as install.sh. The parse
# is `bash -n` rather than `sh -n`: these files declare bash, and dash's grammar
# is not the one they have to satisfy.
recipe lint-flow
    gather "plugin-flow/scripts/cliban-flow" "plugin-flow/tests/*.sh"
    seal flow:linter
    test { bash -n $<in> }
    test { shellcheck -x $<in> }

# No $<in> in the body, so this is one unit over the whole set. Each case builds
# a throwaway git repo and a throwaway board, so fanning out per file would pay
# that cost once per file to prove nothing extra.
#
# `cook test` picks this up like any other test recipe, but it is deliberately
# NOT on `chore check`. The suite drives whatever `cliban` is on PATH — during a
# release that is the *previous* version, so a green here would say nothing
# about the version being released — and `release` and `publish` hang off
# `check`, which would make releasing cliban require an already-installed
# cliban. Fixtures are hermetic; the binary they drive is not this tree's.
recipe test-flow
    seal flow:sources flow:tools
    test { plugin-flow/tests/run.sh }

# No $<in> in the body, so this is one unit over the whole source set rather
# than one cargo run per file.
recipe test-workspace
    seal rust:sources rust:manifests rust:toolchain
    test { cargo test --workspace }

recipe clippy
    seal rust:sources rust:manifests rust:toolchain
    test { cargo clippy --workspace --all-targets -- -D warnings }

# No $<in> in the body: one unit over the whole extension source set, like
# test-workspace. `npm ci` keeps node_modules honest to the lockfile.
recipe vscode-ext
    seal vscode:sources node:toolchain vscode:config
    test { npm --prefix editors/vscode ci --no-audit --no-fund }
    test { npm --prefix editors/vscode run check }

# The whole gate, and what `release` and `publish` hang off. Red here means
# `skipped (upstream-failed)` there, with the body never running.
chore check: version-sync lint-install lint-flow test-workspace clippy vscode-ext

# ---------------------------------------------------------------- mutating

# Not gated: bump is how you *fix* a red version-sync.
chore bump version
    scripts/bump-version.py $<version>

chore release version: check
    scripts/release.sh $<version>

chore publish: check
    scripts/publish-crates.sh

# Downstream packages pin checksums, so these run after the release workflow has
# published the tarballs — not before.
chore tap version
    scripts/update-tap.sh $<version>

chore aur version
    scripts/update-aur.py $<version>

# Hits the network and the live release, so it is a chore rather than a test:
# it must not turn `cook test` red because GitHub had a bad minute.
chore smoke-install
    scripts/smoke-install.sh
