{
  "name": "cliban-vscode",
  "displayName": "Cliban Board",
  "description": "Kanban board for the local cliban CLI: drag cards, tick plan steps, watch agent activity live.",
  "version": "0.1.0",
  "publisher": "lioralabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LioraLabs/cliban"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "cliban.openBoard",
        "title": "Cliban: Open Board"
      },
      {
        "command": "cliban.switchProject",
        "title": "Cliban: Switch Project"
      },
      {
        "command": "cliban.switchMilestone",
        "title": "Cliban: Switch Milestone"
      },
      {
        "command": "cliban.refreshBoard",
        "title": "Cliban: Refresh Board"
      },
      {
        "command": "cliban.newIssue",
        "title": "Cliban: New Issue"
      },
      {
        "command": "cliban.archiveDone",
        "title": "Cliban: Archive Done Issues"
      },
      {
        "command": "cliban.openIssueDocument",
        "title": "Cliban: Open Issue as Document"
      }
    ],
    "configuration": {
      "title": "Cliban",
      "properties": {
        "cliban.executablePath": {
          "type": "string",
          "default": "cliban",
          "description": "Path to the cliban binary (absolute, or a name resolved on PATH)."
        },
        "cliban.dbPath": {
          "type": "string",
          "default": "",
          "description": "SQLite database path, passed as --db. Empty uses cliban's default chain ($CLIBAN_DB, then $XDG_DATA_HOME/cliban/cliban.db, then ~/.local/share/cliban/cliban.db)."
        },
        "cliban.defaultProject": {
          "type": "string",
          "default": "",
          "description": "Project key to open on first launch. Empty prompts with a project picker."
        },
        "cliban.watch.mode": {
          "type": "string",
          "enum": [
            "auto",
            "poll",
            "off"
          ],
          "default": "auto",
          "description": "How the board notices external changes: watch the database files (auto, with poll fallback), poll on an interval, or only refresh manually."
        },
        "cliban.watch.pollIntervalSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 2,
          "description": "Poll cadence when polling is active."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs --tests && node --test dist-test/*.test.js",
    "check": "npm run typecheck && npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
